            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#252A31" Opacity="0.52" />
            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="#1F2227" Opacity="0.16" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#000000" Opacity="0" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#3B424C" Opacity="0.45" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokeDisabled" Color="#000000" Opacity="0" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#848D98" Opacity="0.86" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="#3A3F46" Opacity="0.38" />
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#848D98</Color>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#1E2126" Opacity="0.58" />
            <x:Double x:Key="ScrollBarSize">18</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">10</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">10</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinHeight">72</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinWidth">72</x:Double>
            <x:Double x:Key="SmallScrollThumbScale">0.55</x:Double>
            <x:Double x:Key="SmallScrollThumbOffset">-4</x:Double>
