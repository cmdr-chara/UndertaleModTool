<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="UndertaleModTool_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UndertaleModTool_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WinUiShellBackgroundBrush" Color="#191A1D" />
                    <SolidColorBrush x:Key="WinUiShellOverlayBrush" Color="#191A1D" Opacity="0.88" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundBrush" Color="#222428" />
                    <SolidColorBrush x:Key="WinUiHeaderBackgroundBrush" Color="#202225" Opacity="0.94" />
                    <SolidColorBrush x:Key="WinUiCardBackgroundBrush" Color="#24272D" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundAltBrush" Color="#2A2D33" />
                    <SolidColorBrush x:Key="WinUiPanelStrokeBrush" Color="#3D424A" />
                    <SolidColorBrush x:Key="WinUiAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="WinUiAccentMutedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
                    <SolidColorBrush x:Key="WinUiAccentSubtleBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.14" />
                    <SolidColorBrush x:Key="WinUiQuietTextBrush" Color="#C3C8D0" />
                    <SolidColorBrush x:Key="WinUiMutedTextBrush" Color="#969DA8" />
                    <SolidColorBrush x:Key="WinUiErrorBrush" Color="#F28A83" />
                    <SolidColorBrush x:Key="WinUiSuccessBrush" Color="#9BC2A5" />
                    <SolidColorBrush x:Key="WinUiIconWellBrush" Color="#2B2E34" />
                    <SolidColorBrush x:Key="WinUiDropZoneBackgroundBrush" Color="#202226" Opacity="0.96" />
                    <SolidColorBrush x:Key="WinUiDropZoneStrokeBrush" Color="#555C66" Opacity="0.82" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WinUiShellBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="WinUiShellOverlayBrush" Color="#F3F3F3" Opacity="0.9" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundBrush" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="WinUiHeaderBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="WinUiCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundAltBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="WinUiPanelStrokeBrush" Color="#D2D5D9" />
                    <SolidColorBrush x:Key="WinUiAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="WinUiAccentMutedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                    <SolidColorBrush x:Key="WinUiAccentSubtleBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.1" />
                    <SolidColorBrush x:Key="WinUiQuietTextBrush" Color="#454A52" />
                    <SolidColorBrush x:Key="WinUiMutedTextBrush" Color="#686E77" />
                    <SolidColorBrush x:Key="WinUiErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="WinUiSuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="WinUiIconWellBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="WinUiDropZoneBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="WinUiDropZoneStrokeBrush" Color="#9298A1" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WinUiShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiShellOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiPanelBackgroundAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiPanelStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WinUiAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WinUiAccentMutedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WinUiAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WinUiQuietTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WinUiMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WinUiErrorBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="WinUiSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WinUiIconWellBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiDropZoneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WinUiDropZoneStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="MutedDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource WinUiMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="CompactIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="RecentFileCardButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Background" Value="{ThemeResource WinUiCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WinUiPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
