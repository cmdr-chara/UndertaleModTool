            <SolidColorBrush x:Key="ListViewItemSelectedPointerOverBorderBrush" Color="#F17D76" />
            <SolidColorBrush x:Key="ListViewItemSelectedPressedBorderBrush" Color="#C84E4B" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
