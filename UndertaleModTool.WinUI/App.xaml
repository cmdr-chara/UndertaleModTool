            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#34373D" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#383C43" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4B535E" />
